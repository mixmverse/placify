    "spotify:json": "tsx scripts/spotify-seed.ts --output-only",
    "curators:seed": "tsx scripts/seed-curators.ts",
    "curators:seed:pdf": "tsx scripts/seed-pdf-curators.ts",
    "curators:seed:online": "tsx scripts/seed-online-curators.ts",
    "curators:seed:african": "tsx scripts/seed-african-curators.ts",
    "curators:seed:batch3": "tsx scripts/seed-batch3-curators.ts",
